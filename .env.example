APP_NAME=Trust Trash API
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Application database (local Docker Compose defaults)
DATABASE_URL=postgresql+psycopg://trust_trash:trust_trash_dev_only@localhost:5432/trust_trash

# Optional local search profile
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=trust-trash

# Optional local cache / queue profile
REDIS_URL=redis://localhost:6379/0

# Never place real production credentials in this file.
SECRET_KEY=replace-this-local-development-only
